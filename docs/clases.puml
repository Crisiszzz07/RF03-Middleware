@startuml
title RF03 · clases reales
skinparam classAttributeIconSize 0
hide empty members
class ClienteRadicacion {
  - cabeza: ManejadorSeguridad [1] {readOnly}
  - auditoria: RegistroAuditoriaEnMemoria [1] {readOnly}
  - repositorio: RepositorioPropuestasEnMemoria [1] {readOnly}
  + ejecutar(token: String, titulo: String): Ejecucion
}
abstract class ManejadorSeguridad {
  # siguiente: ManejadorSeguridad [0..1] {readOnly}
  {abstract} + procesar(solicitud: SolicitudRadicacion): RespuestaRadicacion
  # continuar(solicitud: SolicitudRadicacion): RespuestaRadicacion
  # marcarNoEjecutados(solicitud: SolicitudRadicacion, codigo: int): void
}
class ConfiguracionCadena {
  + cliente(repositorio: RepositorioPropuestasEnMemoria, auditoria: RegistroAuditoriaEnMemoria): ClienteRadicacion
  + repositorio(): RepositorioPropuestasEnMemoria
  + auditoria(): RegistroAuditoriaEnMemoria
}
class AuditoriaMiddleware {
  - registro: RegistroAuditoriaEnMemoria [1] {readOnly}
  + procesar(solicitud: SolicitudRadicacion): RespuestaRadicacion
}
class AutenticacionMiddleware {
  - validador: ValidadorTokenSimulado [1] {readOnly}
  + procesar(solicitud: SolicitudRadicacion): RespuestaRadicacion
}
class AutorizacionMiddleware {
  - politica: PoliticaPermisosSimulada [1] {readOnly}
  + procesar(solicitud: SolicitudRadicacion): RespuestaRadicacion
}
class RadicarPropuestaHandler {
  - repositorio: RepositorioPropuestasEnMemoria [1] {readOnly}
  + procesar(solicitud: SolicitudRadicacion): RespuestaRadicacion
}
class RegistroAuditoriaEnMemoria {
  - registros: CopyOnWriteArrayList<Registro> {readOnly}
  + registrar(solicitud: SolicitudRadicacion, respuesta: RespuestaRadicacion): Registro
  + listar(): List<Registro>
}
class ValidadorTokenSimulado {
  - identidades: Map<String, IdentidadSimulada> {readOnly}
  + validar(token: String): Optional<IdentidadSimulada>
}
class PoliticaPermisosSimulada {
  + puedeRadicar(identidad: IdentidadSimulada): boolean
}
class RepositorioPropuestasEnMemoria {
  - propuestas: ConcurrentHashMap<String, Propuesta> {readOnly}
  - secuencia: AtomicInteger {readOnly}
  + guardar(solicitud: SolicitudRadicacion): String
  + listar(): List<Propuesta>
}
class SolicitudRadicacion {
  - id: String {readOnly}
  - token: String (no serializado) {readOnly}
  - titulo: String {readOnly}
  - identidad: IdentidadSimulada [0..1]
  - traza: List<EventoTraza> {readOnly}
  + autenticar(identidad: IdentidadSimulada): void
  + evento(...): void
  + traza(): List<EventoTraza>
}
class RespuestaRadicacion {
  - codigo: int {readOnly}
  - mensaje: String {readOnly}
  - propuestaId: String [0..1] {readOnly}
}
class EventoTraza {
  - paso: int {readOnly}; manejador, metodo: String {readOnly}
  - estado, direccion, accion, motivo: String {readOnly}
  - identidad, titulo: String {readOnly}; codigo: Integer {readOnly}
  - archivo, fragmento, explicacion: String {readOnly}
}
class IdentidadSimulada {
  - usuario: String {readOnly}
  - perfil: Perfil (INVESTIGADOR | EVALUADOR) {readOnly}
}
class RadicacionController {
  - cliente: ClienteRadicacion [1] {readOnly}
  - repositorio: RepositorioPropuestasEnMemoria [1] {readOnly}
  - auditoria: RegistroAuditoriaEnMemoria [1] {readOnly}
  + radicar(entrada: Entrada): ResponseEntity<Ejecucion>
  + propuestas(), auditoria(), jsonInvalido()
}
class FragmentosFuente {
  {static} + leer(clase: String, clave: String): String
}
AuditoriaMiddleware --|> ManejadorSeguridad
AutenticacionMiddleware --|> ManejadorSeguridad
AutorizacionMiddleware --|> ManejadorSeguridad
RadicarPropuestaHandler --|> ManejadorSeguridad
ConfiguracionCadena ..> ClienteRadicacion : construye
ConfiguracionCadena ..> ManejadorSeguridad : compone la cadena
note bottom of ManejadorSeguridad
Referencias mostradas solo como atributos; sin asociaciones duplicadas.
El sucesor se fija mediante el constructor; no hay setters.
RadicarPropuestaHandler es terminal: siguiente = null.
end note
legend bottom
Constructores, getters y records anidados abreviados.
Servicios y almacenamiento simulados; no son seguridad de producción.
{readOnly} indica referencia final; no implica inmutabilidad de su contenido.
endlegend
@enduml
